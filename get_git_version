#!/bin/bash
cat <<!
#include "LA_version.h"
const char LA::version[] = 
!
echo -n '"'
echo -n `git describe`
echo -n ' HEAD commit = '
head=`git rev-parse HEAD`
echo -n $head
echo -n ' dated '
echo -n `git show -s --format=%ci $head`
echo -n ' compiled on ' `date` 'at' `hostname` 'by' `whoami`
echo -n '"'
echo ';' 
